{
  "name": "ustazon-content-bot",
  "private": true,
  "description": "Ustazon educational Shorts generator and existing simulation tools",
  "scripts": {
    "dev": "node scripts/serve-game.mjs",
    "test": "node --test tests/web.test.cjs tests/session.test.cjs tests/motion.test.cjs",
    "test:browser": "node tests/browser.test.mjs",
    "video": "node ustazon/cli.mjs render",
    "video:next": "node ustazon/cli.mjs next",
    "video:list": "node ustazon/cli.mjs list",
    "video:check": "node ustazon/cli.mjs check",
    "video:preview": "node ustazon/cli.mjs preview",
    "test:ustazon": "node --test ustazon/test/model.test.mjs ustazon/test/encode.test.mjs ustazon/test/automation.test.mjs ustazon/test/youtube.test.mjs ustazon/test/reliability.test.mjs ustazon/test/budget.test.mjs ustazon/test/quality.test.mjs ustazon/test/remote-state.test.mjs ustazon/test/social.test.mjs ustazon/test/presentation.test.mjs",
    "video:ai:probe": "node ustazon/daily.mjs probe",
    "video:daily": "node ustazon/daily.mjs generate",
    "video:plan": "node ustazon/daily.mjs plan",
    "video:status": "node ustazon/daily.mjs status",
    "video:worker": "node ustazon/supervisor.mjs start",
    "video:publish": "node ustazon/daily.mjs publish",
    "video:youtube:connect": "node ustazon/daily.mjs youtube-auth",
    "video:stop": "node ustazon/supervisor.mjs stop",
    "video:health": "node ustazon/daily.mjs health",
    "video:budget": "node ustazon/daily.mjs budget",
    "video:catalog-sync": "node ustazon/sync-catalog.mjs",
    "video:review": "node ustazon/review.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=24"
  }
}
