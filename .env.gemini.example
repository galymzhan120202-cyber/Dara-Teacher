# Copy to .env.local in the project root. Do not commit real keys.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_VOICE=Kore

# Set true only after checking this key belongs to a Free Tier project with billing disabled.
# This is your confirmation, not an automated billing check. Request caps do not make paid usage free.
GEMINI_FREE_TIER_CONFIRMED=false
